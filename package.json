{
  "name": "little-mage",
  "version": "1.0.0",
  "description": "小法師 Little Mage — 手機直式 3D 動作 RPG（Three.js + TypeScript）",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Wei Studio",
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^0.22.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
