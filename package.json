{
  "name": "little-mage",
  "version": "1.95.0",
  "description": "神格覺醒 Divine Awakening（曾名古希臘探險、戰鬥法師 Battle Mage、小法師 Little Mage）— 手機直式 3D 動作 RPG（Three.js + TypeScript）",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:sync": "npm run build && cap sync",
    "app:open": "cap open android"
  },
  "author": "Wei Studio",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^0.22.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
